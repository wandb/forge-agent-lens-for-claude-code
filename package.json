{
  "name": "@coreweave/forge-agent-lens-for-claude-code",
  "version": "0.4.0",
  "description": "Trace Claude Code sessions with CoreWeave Forge AgentLens for observability and debugging",
  "type": "module",
  "bin": {
    "forge-agent-lens-for-claude-code": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/build/copy-version-module.mjs",
    "build:watch": "tsc --watch",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "setup-hooks": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@coreweave/forge-sdk": "0.1.0-beta.0",
    "@opentelemetry/api": "^1.9.1",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.178",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/node": "^18.19.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "files": [
    "dist/",
    "hooks/",
    "skills/",
    ".claude-plugin/",
    "LICENSE",
    "LICENSES/",
    "NOTICE",
    "REUSE.toml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreweave/forge-agent-lens-for-claude-code.git"
  },
  "license": "Apache-2.0"
}
